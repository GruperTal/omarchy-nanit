#!/usr/bin/env bash
# Portable checks: manifest shape, QML entry points exist, the CLI parses.
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
python3 "$root/scripts/validate_manifest.py" "$root"
python3 -m py_compile "$root/bin/nanit.py"
bash -n "$root/bin/nanit"
# The lock must pin every requirement and carry a hash for each one.
python3 - "$root/requirements.lock" <<'PY'
import re, sys
text = open(sys.argv[1]).read()
reqs = re.findall(r"^([A-Za-z0-9_.-]+)==([^\s\\]+)", text, re.M)
assert reqs, "no pinned requirements"
for name, _ in reqs:
    assert re.search(rf"^{re.escape(name)}==.*\\\n(    --hash=sha256:[0-9a-f]{{64}}( \\\n)?)+", text, re.M), f"{name}: missing hashes"
print(f"requirements.lock: {len(reqs)} pinned, hashed requirements")
PY
grep -q '"service": "Service.qml"' "$root/manifest.json"
for f in Service.qml Panel.qml NanitIcon.qml; do test -f "$root/$f"; done

if command -v omarchy >/dev/null 2>&1; then
  omarchy plugin validate "$root"
fi

printf 'All portable plugin checks passed.\n'
